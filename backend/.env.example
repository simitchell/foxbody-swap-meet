# Backend environment variables, read by backend_project/settings.py.
#
# Local dev: copy this file to backend/.env and fill in the two <...> values.
#   cp backend/.env.example backend/.env
# Production: never use a .env file. Railway Variables on each service hold the
# real values (web service: foxbody-swap-meet; cron service: signup-digest).
# Variables exported in your shell (e.g. by dev.sh) take priority over .env.

# --- Core -------------------------------------------------------------------

# Local Postgres (Postgres.app): the default superuser is your macOS username,
# no password. Production: ${{Postgres.DATABASE_URL}}.
# (If DATABASE_URL is unset, settings.py requires DB_HOST, DB_NAME, DB_PORT,
# DB_USER and DB_PASSWORD instead.)
DATABASE_URL=postgres://<your-macos-username>@localhost:5432/foxbody_local

# Any long random string locally; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Unset falls back to a public placeholder, so always set it.
SECRET_KEY=<generate-a-random-string>

# true locally (lets Django serve /media/ uploads). Never set in production.
DEBUG=true

# --- Uploads and image moderation -------------------------------------------

# Blank locally: uploads go to mediafiles/ instead of the prod S3 bucket.
# Production: the S3/Rekognition IAM keys. Any non-blank AWS_ACCESS_KEY_ID
# switches storage to S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# true locally, since there are no AWS credentials for the Rekognition check.
# Leave unset in production.
SKIP_IMAGE_MODERATION=true

# --- Signup bot protection --------------------------------------------------

# Cloudflare's documented "always passes" test secret for local dev.
# Production: the real Turnstile secret key for foxbodyswapmeet.com.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Email ------------------------------------------------------------------

# Leave both unset locally: emails print to the runserver console.
# Production: the Resend API key, and SEND_REAL_EMAIL=true. Real sending needs
# both, so a stray API key alone never sends mail.
RESEND_API_KEY=
SEND_REAL_EMAIL=

# Links in emails. Defaults are the production URLs; point them at the local
# servers for dev.
SITE_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Who gets the weekly signup digest (send_signup_digest). Defaults to
# sam@foxbodyswapmeet.com if unset.
# SIGNUP_DIGEST_TO=
